# 🐳 Docker Training Environment
# Optimized for ML model training without virtual environments

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV TF_CPP_MIN_LOG_LEVEL=2

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python ML dependencies (no virtual environment needed)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    numpy==1.24.3 \
    pandas==2.0.3 \
    scikit-learn==1.3.0 \
    joblib==1.3.2 \
    tensorflow==2.15.0 \
    keras==2.15.0 \
    yfinance==0.2.18 \
    requests==2.31.0 \
    xgboost==2.0.0 \
    lightgbm==4.1.0 \
    matplotlib==3.8.0 \
    seaborn==0.13.0 \
    plotly==5.17.0 \
    numba==0.58.0 \
    tqdm==4.66.0 \
    peewee==3.16.3 \
    websockets==11.0.3 \
    markdown==3.5.1 \
    pygments==2.16.1 \
    fonttools==4.43.1

# Create app user for security
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -s /bin/bash -m appuser

# Set working directory
WORKDIR /app

# Copy training scripts (no virtual environment references)
COPY --chown=appuser:appgroup scripts/ ./scripts/

# Create persistent data directory structure
RUN mkdir -p /app/persistent_data/{ml_models,ml_cache,scalers,stock_data/{historical,cache,predictions},logs,config,backups,database} && \
    chown -R appuser:appgroup /app/persistent_data && \
    chmod -R 755 /app/persistent_data

# Create training initialization script
RUN echo '#!/bin/bash\n\
echo "🐳 Docker Training Environment Ready"\n\
echo "📊 Available Python packages:"\n\
python3 -c "import tensorflow as tf; print(f\"  - TensorFlow: {tf.__version__}\")" 2>/dev/null || echo "  - TensorFlow: Not available"\n\
python3 -c "import yfinance; print(f\"  - yfinance: {yfinance.__version__}\")" 2>/dev/null || echo "  - yfinance: Available"\n\
python3 -c "import sklearn; print(f\"  - scikit-learn: {sklearn.__version__}\")" 2>/dev/null || echo "  - scikit-learn: Available"\n\
python3 -c "import pandas as pd; print(f\"  - pandas: {pd.__version__}\")" 2>/dev/null || echo "  - pandas: Available"\n\
python3 -c "import numpy as np; print(f\"  - numpy: {np.__version__}\")" 2>/dev/null || echo "  - numpy: Available"\n\
echo ""\n\
echo "📁 Persistent data directory: /app/persistent_data"\n\
echo "🎯 Ready for model training!"\n\
' > /app/training_init.sh && chmod +x /app/training_init.sh

# Switch to non-root user
USER appuser

# Default command shows training environment info
CMD ["/app/training_init.sh"]
